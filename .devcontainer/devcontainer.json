{
  // Dev container for editing Markdown, OWL and SKOS. See README.md in this directory.
  "name": "sona",
  "build": { "dockerfile": "Containerfile" },

  // Rootless Podman: container root maps to the host user, so the bind-mounted
  // workspace is writable on any host UID (macOS 501, Linux 1000, ...).
  "remoteUser": "root",

  // ":Z" relabels the mount for SELinux hosts (Fedora, RHEL); harmless elsewhere.
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/sona,type=bind,consistency=cached,z=true",
  "workspaceFolder": "/workspaces/sona",

  // No host credential directories (~/.ssh, ~/.config/gh, ...) are mounted.

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "GitHub.vscode-pull-request-github",
        "task.vscode-task",
        "selfagency.beans-vscode",
        "yzhang.markdown-all-in-one",
        "DavidAnson.vscode-markdownlint",
        "stardog-union.stardog-rdf-grammars",
        "stardog-union.vscode-langserver-turtle",
        "redhat.vscode-xml",
        "jnoortheen.nix-ide"
      ],
      "settings": {
        "files.associations": {
          "*.owl": "xml",
          "*.rdf": "xml",
          "*.ttl": "turtle"
        },
        "files.eol": "\n",
        "git.autofetch": false,
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
