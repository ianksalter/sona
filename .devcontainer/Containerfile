# Base: official Debian 13 "trixie" (current stable) slim image from Docker Hub.
# Pinned to a point release for reproducibility; bump deliberately when updating.
FROM docker.io/library/debian:13.1-slim

ARG NIX_INSTALLER=https://nixos.org/nix/install

# Minimal OS packages: git/ssh are needed by VS Code, xz/curl by the Nix installer.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      bash ca-certificates curl git openssh-client xz-utils \
 && rm -rf /var/lib/apt/lists/*

# Single-user Nix installed as root. With rootless Podman, container root maps to the
# host user, so no host UID/GID needs to be configured. Do NOT use with rootful engines.
RUN mkdir -m 0755 /nix \
 && curl -fsSL "$NIX_INSTALLER" | sh -s -- --no-daemon \
 && mkdir -p ~/.config/nix \
 && echo "experimental-features = nix-command flakes" > ~/.config/nix/nix.conf \
 && echo '. ~/.nix-profile/etc/profile.d/nix.sh' >> ~/.bashrc
ENV PATH=/root/.nix-profile/bin:/root/go/bin:$PATH
